APP_NAME="Tracely API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Default: SQLite (zero extra database installation required)
DB_CONNECTION=sqlite
DB_FOREIGN_KEYS=true

# Optional: Switch to XAMPP MySQL / MariaDB anytime by uncommenting below:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=docstrack
# DB_USERNAME=root
# DB_PASSWORD=

# Optional: Switch to PostgreSQL for production deployment:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=docstrack
# DB_USERNAME=docstrack
# DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"
