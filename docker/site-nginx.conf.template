set_real_ip_from 10.0.0.0/8;
set_real_ip_from 100.64.0.0/10;
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 192.168.0.0/16;
set_real_ip_from fc00::/7;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

limit_req_zone $binary_remote_addr zone=tracely_site_req:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=tracely_site_dl:10m rate=10r/m;
limit_conn_zone $binary_remote_addr zone=tracely_site_conn:10m;

server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;

    # Slowloris & connection flood hardening
    client_max_body_size 1m;
    client_header_timeout 10s;
    client_body_timeout 10s;
    keepalive_timeout 20s;
    send_timeout 15s;
    reset_timedout_connection on;

    limit_conn tracely_site_conn 30;
    limit_req_status 429;
    limit_conn_status 429;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/javascript
        application/json
        application/xml
        image/svg+xml;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=()" always;

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location = /download {
        limit_req zone=tracely_site_dl burst=8 nodelay;
        return 302 ${BACKEND_PUBLIC_URL}/download;
    }

    location = /download/tracely.apk {
        limit_req zone=tracely_site_dl burst=6 nodelay;
        return 302 ${BACKEND_PUBLIC_URL}/download/tracely.apk;
    }

    location /assets/ {
        limit_req zone=tracely_site_req burst=80 nodelay;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    location = /index.html {
        limit_req zone=tracely_site_req burst=30 nodelay;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location / {
        limit_req zone=tracely_site_req burst=60 nodelay;
        try_files $uri $uri/ /index.html;
    }
}
